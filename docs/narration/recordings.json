  "clips": [
    {
      "clip_key": "warmup_welcome",
      "text": "Welcome! Thanks so much for playing our game! You’re going to watch some short stories about different people and answer a few questions about what happened. For some of the questions, you’ll show us what you think by moving cookies around the screen. Before the stories begin, let’s practice moving the cookies!",
      "sha256": "ecadc8473fc9ebca72e67c770cd72f467bc81f59076273b077d1a3f55807c655"
    },
    {
      "clip_key": "cookie_identify_claire",
      "text": "This is Claire.",
      "sha256": "fd028fe75e9a91fa707a10929b4c691db0d07cd5ebb0d3083f135d97882ce129"
    },
    {
      "clip_key": "cookie_identify_michael",
      "text": "This is Michael. He has three cookies.",
      "sha256": "eae5334a5b455dc769c7eaa0bd2edef6c44ca6dd6f960829ee65d8d832165ce7"
    },
    {
      "clip_key": "cookie_identify_jar",
      "text": "This is the cookie jar.",
      "sha256": "6ec1028fe4f8a44d98b168f9ce1c94685c74b14d06bd6b9aa3a935a96570e136"
    },
    {
      "clip_key": "cookie_explanation_opening",
      "text": "In our game, you can move cookies wherever you like.",
      "sha256": "9d155cd72ffc09869899c65e8b570e37c0a854f05487819fb012da32a608b704"
    },
    {
      "clip_key": "cookie_explanation_person",
      "text": "If you move cookies to another person, that person gets to keep them.",
      "sha256": "f442707f746b45c55cc7084290da1e5c0787f1ec92c96ea2826423be5ba4d60f"
    },
    {
      "clip_key": "cookie_explanation_jar",
      "text": "If you move cookies to the cookie jar, nobody gets them.",
      "sha256": "9aa46a8ce7e0dcc3c6274252c68ce50eb9da3e11fe89acb9cbddd0504a88da1b"
    },
    {
      "clip_key": "cookie_practice_jar",
      "text": "Let’s try! Move some of Michael’s cookies to the cookie jar.",
      "sha256": "df56d7698f62fb0ac888585d4ea6ad0f5ba352b086260d78ce5db24784b1992d"
    },
    {
      "clip_key": "cookie_practice_person",
      "text": "Now move some of Michael’s cookies to Claire.",
      "sha256": "038e4270c56e102ae739d69cad148cdb229bcd3b91e72593524505446b97fb43"
    },
    {
      "clip_key": "thank_you_practice",
      "text": "Thank you!",
      "sha256": "2a9119ea8258d7123f9c3fe16298428aff9ffa7c707cfc5f2b982f81e7c7ab35"
    },
    {
      "clip_key": "fault_explanation_intro",
      "text": "In our game, you’ll be asked how much each person is at fault.",
      "sha256": "d03ec0adc59c0a63624173e4edbc9b1176053868ef1fe80d2a0908d55482e911"
    },
    {
      "clip_key": "fault_explanation_large",
      "text": "If you think someone is a lot at fault, make a lot of their bar blue.",
      "sha256": "5eae336a0b3c9c9294a772b3ac90af15f3e10f3b83f1d3e51242367c54f7a3cb"
    },
    {
      "clip_key": "fault_explanation_small",
      "text": "If you think they are a little at fault, make a small part of their bar blue.",
      "sha256": "30c590601cf90af9b99141c664bb774e9a6d7103be3fae1c6d161889a0a68dee"
    },
    {
      "clip_key": "fault_explanation_zero",
      "text": "If you think they are not at fault, click the little part at the beginning of their bar.",
      "sha256": "bed6824c70a86693f99f6c59689d51a91971cef707996cff5b302b3057f0a9eb"
    },
    {
      "clip_key": "rating_practice_try",
      "text": "Now you try!",
      "sha256": "522d0e29a7b637ffdee4b541c311354626e1850e74b2c5b7143a47a85c076a9d"
    },
    {
      "clip_key": "fault_practice_large",
      "text": "Show that Michael is a lot at fault and Claire is not at fault.",
      "sha256": "ffb56bd89dff22fd82e85b00a4aae4c71862592025162e207b7e7e7354b55508"
    },
    {
      "clip_key": "fault_practice_large_reversed",
      "text": "Show that Claire is not at fault and Michael is a lot at fault.",
      "sha256": "ed460a9bf46940c9df5dc42560d485c9e8a343ba53b82be16e376017477291d2"
    },
    {
      "clip_key": "fault_practice_small",
      "text": "Show that Claire is a little at fault and Michael is not at fault.",
      "sha256": "f3d90511f7be8b22a5529c0693bad06c6082cf4f05faa51d35ea656128f4dae8"
    },
    {
      "clip_key": "fault_practice_small_reversed",
      "text": "Show that Michael is not at fault and Claire is a little at fault.",
      "sha256": "9da0c4466dbc1dc5ddb7914c60603038d2cdf47cd5e233d6b1237ecb6dd8d5ab"
    },
    {
      "clip_key": "fault_explanation_second",
      "text": "You’ll also use the same bars to show how much each person is at fault. A bigger bar means more at fault.",
      "sha256": "7a23094a696bc55a96947eb17de94aad101484b538a229f2652c7bd89a8e91ef"
    },
    {
      "clip_key": "ready",
      "text": "Thank you! Now let’s see the stories.",
      "sha256": "a1870435d92cdbf21f13412db8650111130b033aba4a49a6a0b1aacf43e29e7e"
    },
    {
      "clip_key": "main_cookie_question",
      "text": "Now that you saw what happened, should any of the cookies be moved?",
      "sha256": "17bc3ccdc18fd7cc019b7a296445d5748c58b3779644bdbf9f65049f5fb730c9"
    },
    {
      "clip_key": "main_move_instruction",
      "text": "Move the cookies wherever you think they should go.",
      "sha256": "aecb97dc7320728269544f576ffa1a98b83d4b52910f06d7c8d141f275d8e937"
    },
    {
      "clip_key": "main_fault",
      "text": "Now that you saw what happened, how much do you think each person is at fault?",
      "sha256": "0660ef9ef793cd4c51d042e070d2319c1cfe354d51b5854b61020aac18a70c00"
    },
    {
      "clip_key": "thank_you_case_1",
      "text": "Thank you for helping!",
      "sha256": "00b57291d5a07ea8bea3b545ba77d2bfba799cf0445d0f07cd338dd4dfde7e35"
    },
    {
      "clip_key": "thank_you_case_5",
      "text": "Thank you! There are a few more stories.",
      "sha256": "cd143a65dc023ffc313b6877144ddad16ee3663609aa6e8e5292e2c8d0a94ced"
    },
    {
      "clip_key": "thank_you_case_8",
      "text": "Thank you so much for helping us!",
      "sha256": "aff72dd4bc547177574c07b42d5b85f2973d69901379d0c301c95cf970e8d05d"
    },
    {
      "clip_key": "negligence_spill_01",
      "text": "This is Finn.",
      "sha256": "879565faa12c4f8dd63d9317391e2d75fc60924ecc288c71bc70a536ac0ec161"
    },
    {
      "clip_key": "negligence_spill_03",
      "text": "This is Cleo.",
      "sha256": "cab3ba11c2bbf50cd78ff6356e1029e6b69bd4c003069e606060482aead92fbd"
    },
