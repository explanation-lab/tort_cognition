    {
      "clip_key": "exp2_strict_liability_wolf_08",
      "text": "Andy puts his cookies on the ground and walks away.",
      "sha256": "6986f10e3783acf584c88a3a33e7595502f23e82d4c0b58d838c2b6f914bcf58"
