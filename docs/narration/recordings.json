      "clip_key": "exp2_strict_liability_alligator_08",
      "text": "Ella puts her cookies on the ground and walks away.",
      "sha256": "d712d6fbc5df26955b13d2300ee0be1a77f25ab27d87e97f9990d35f7744cf26"
